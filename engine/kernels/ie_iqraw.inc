/* ie_iqraw.inc -- raw GGUF IQ/K weight blocks (MAT_RAWQ) against the engine's
 * Q8 activation buffers. One source, two builds:
 *
 *   src/cpu.c, src/model.c  #define IE_RQP const uint8_t ... #include "../kernels/ie_iqraw.inc"
 *   kernels/ie_kernels.c    #define IE_RQP const G u8    ... #include "ie_iqraw.inc"
 *   (host only: #define IE_RAWQ_HOST before the include for the float
 *    dequantizers used at load time)
 *
 * The includer defines:
 *   IE_RQP   the weight/activation byte pointer type (const G u8 on the GPU)
 *   IE_RQF   the float pointer type                     (const G float)
 *   IE_RQU   the u32 pointer type                       (const G u32)
 * and, for the float dequantizers, IE_RAWQ_HOST. A cast written here as
 * (IE_RQF *) means "the includer's qualified pointer type".
 *
 * Block formats are ggml's (ggml-common.h), 256 weights per block, raw GGUF
 * order (no repack). Per 32-weight sub-block s the exact decomposition is
 *
 *   contribution_s = da_s * ( d_s * sc_s * idot_s  -  dmin_s * mn_s * asum_s )
 *
 * where idot_s = sum of (integer weight value) * (int8 activation),
 * asum_s = sum of the int8 activations, and dmin/mn are 0 for every format
 * but Q2_K. This is what ie_rq_dot returns for a whole 256-weight block.
 *
 * Four formats scale 16 weights at a time rather than 32 -- Q2_K, IQ2_XS,
 * IQ2_S, IQ1_M -- and the IQ1 formats add a +-0.125 grid delta against the
 * activation sum instead of a min: those work per 16-weight half (IQ1_M per
 * 8-weight group, because its delta is per group) and use exact partial sums
 * of the int8 activations, which is the same value ggml's vec_dot computes
 * from the Q8 bsums. Sub-blocks are visited in ascending order, the low half
 * first, and every weight value is the one ggml's dequantize_row_* produces.
 *
 * ie_rq_dot(type, p, xq, nb, qb): p is one raw 256-weight block of a row;
 * xq is the Q8 buffer of that row (nb blocks of 32, written by the engine's
 * quantize kernel):
 *   int8 values  xq[qb * 256 + 0 .. qb * 256 + 256)
 *   scales       ((IE_RQF *)xq + 8 * nb)[qb * 8 + s]
 *   sums         ((IE_RQU *)xq + 9 * nb)[qb * 8 + s]
 *
 * The raw block pointer is read with byte loads only (it may be unaligned),
 * and the grids are the ggml tables, verbatim.
 */
#ifndef IE_IQRAW_INC
#define IE_IQRAW_INC

/* ie_dot4_us / ie_dot4_ss / ie_sum_s8x4 / ie_byte: the verified core. On the
 * GPU ie_dot4_* is v_dot4_i32_iu8, on the host its model. */
#include "../core/ie_core.h"

/* ---------------------------------------------------------------- types */
typedef unsigned char ie_rq_u8;
typedef unsigned short ie_rq_u16;
typedef unsigned int ie_rq_u32;
typedef signed char ie_rq_i8;
typedef unsigned long long ie_rq_u64;

/* ggml tensor types handled here (the engine's common.h enum). */
#define IE_RQ_Q2_K 10u
#define IE_RQ_IQ2_XXS 16u
#define IE_RQ_IQ2_XS 17u
#define IE_RQ_IQ3_XXS 18u
#define IE_RQ_IQ3_S 21u
#define IE_RQ_IQ1_S 19u
#define IE_RQ_IQ2_S 22u
#define IE_RQ_IQ1_M 29u

/* Bytes of one 256-weight block, 0 if not handled. */
static inline ie_rq_u32 ie_rq_bs(ie_rq_u32 type) {
  switch (type) {
    case IE_RQ_Q2_K: return 84u;
    case IE_RQ_IQ2_XXS: return 66u;
    case IE_RQ_IQ2_XS: return 74u;
    case IE_RQ_IQ3_XXS: return 98u;
    case IE_RQ_IQ3_S: return 110u;
    case IE_RQ_IQ1_S: return 50u;
    case IE_RQ_IQ2_S: return 82u;
    case IE_RQ_IQ1_M: return 56u;
    default: return 0u;
  }
}

/* ---------------------------------------------------------------- tables */
