/* --------------------------------------------------------------- helpers */

/* IEEE half -> float, exact. The kernels convert with a _Float16 cast (see
 * the (float)ddr[...] reads in ie_kernels.c), the host with ie_f16_to_f32
 * (src/common.c): the same bits for every finite value. */
#ifndef __AMDGCN__
float ie_f16_to_f32(unsigned short h); /* the engine's exact half -> float */
static inline float ie_rq_h2f(ie_rq_u32 h) { return ie_f16_to_f32((unsigned short)h); }
#else
static inline float ie_rq_h2f(ie_rq_u32 h) {
  union { ie_rq_u16 u; _Float16 f; } v;
  v.u = (ie_rq_u16)h;
  return (float)v.f;
}
#endif

/* One / two / four bytes of a raw block: byte loads only, or 2-byte aligned on GPU. */
static inline ie_rq_u32 ie_rq_b(IE_RQP *p, ie_rq_u32 i) { return (ie_rq_u32)p[i]; }
static inline ie_rq_u32 ie_rq_b16(IE_RQP *p, ie_rq_u32 i) { return ie_rq_b(p, i) | (ie_rq_b(p, i + 1u) << 8u); }
static inline ie_rq_u32 ie_rq_b32(IE_RQP *p, ie_rq_u32 i) { return ie_rq_b16(p, i) | (ie_rq_b16(p, i + 2u) << 16u); }

#ifdef __AMDGCN__
struct __attribute__((packed, aligned(2))) ie_rq_u32p2 { ie_rq_u32 v; };
static inline ie_rq_u32 ie_rq_a16(IE_RQP *p, ie_rq_u32 o) {
  return (ie_rq_u32)*(const __attribute__((address_space(1))) ie_rq_u16 *)(p + o);
}
static inline ie_rq_u32 ie_rq_a32(IE_RQP *p, ie_rq_u32 o) {
  return ((const __attribute__((address_space(1))) struct ie_rq_u32p2 *)(p + o))->v;
}
#else
static inline ie_rq_u32 ie_rq_a16(IE_RQP *p, ie_rq_u32 o) { return ie_rq_b16(p, o); }
static inline ie_rq_u32 ie_rq_a32(IE_RQP *p, ie_rq_u32 o) { return ie_rq_b32(p, o); }
#endif

/* The 4 int8 activations of sub-block s at word w of the row's Q8 buffer
 * (x points at sub-block 0 of the 256-weight block). */
static inline ie_rq_u32 ie_rq_aw(IE_RQP *x, ie_rq_u32 s, ie_rq_u32 w) { return ((IE_RQU *)(x + 32u * s))[w]; }

/* Exact sums of the int8 activations: 8 (one grid group) and 16 (one scale).
 * A dot4 against bytes of 1 is the sum of the 4 signed bytes (ie_sum_s8x4,
 * the same 32-bit value): one instruction per word instead of four byte
 * extracts and three adds. */
static inline ie_rq_u32 ie_rq_as8(IE_RQP *x, ie_rq_u32 s, ie_rq_u32 g) {
  return ie_dot4_ss(ie_dot4_ss(0u, ie_rq_aw(x, s, 2u * g), 0x01010101u), ie_rq_aw(x, s, 2u * g + 1u), 0x01010101u);
}
static inline ie_rq_u32 ie_rq_as16(IE_RQP *x, ie_rq_u32 s, ie_rq_u32 h) { return ie_rq_as8(x, s, 2u * h) + ie_rq_as8(x, s, 2u * h + 1u); }

/* 4 or 8 sign bits as byte masks (0x00 / 0xff). */
static inline ie_rq_u32 ie_rq_mask4(ie_rq_u32 b) {
  /* b < 16: b * (1 + 2^7 + 2^14 + 2^21) holds bit i of b at bits i, i + 7, i + 14, i + 21 with no carries, so
   * the AND keeps exactly bit i at bit 0 of byte i. On the GPU one byte permute turns each such bit into
   * 0xff (selector byte 13) or 0x00 (selector byte 12); the host does the same as (t << 8) - t. Bitwise
   * the same masks as the former per-bit multiplies, in about a third of the vector instructions. */
  const ie_rq_u32 t = (b * 0x00204081u) & 0x01010101u;
#ifdef __AMDGCN__
  return __builtin_amdgcn_perm(0u, 0u, t | 0x0C0C0C0Cu);
#else
  return (t << 8u) - t;
#endif
}
static inline ie_rq_u64 ie_rq_mask8(ie_rq_u32 b) {
  return (ie_rq_u64)ie_rq_mask4(b & 15u) | ((ie_rq_u64)ie_rq_mask4(b >> 4u) << 32u);
}

/* The 4 grid magnitudes of w with their signs applied, as int8 bytes: -m is
 * ~m + 1, and the add cannot carry out of a byte because every grid
 * magnitude is 4 or more (iq3xxs 4..62, the iq2 grids 8..43). */
static inline ie_rq_u32 ie_rq_ssign(ie_rq_u32 w, ie_rq_u32 mask) { return (w ^ mask) + (mask & 0x01010101u); }

/* The signed grid value e (0..7) of a word, and the same with the sign of
 * mask byte e applied, for the float dequantizers. */
static inline ie_rq_u32 ie_rq_gb(ie_rq_u64 g, ie_rq_u32 e) { return (ie_rq_u32)(g >> (8u * e)) & 255u; }
static inline float ie_rq_gval(ie_rq_u64 g, ie_rq_u64 m, ie_rq_u32 e, float s) {
  const float v = s * (float)ie_rq_gb(g, e);
  return ie_rq_gb(m, e) != 0u ? -v : v;
}

