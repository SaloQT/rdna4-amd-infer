/* ------------------------------------------------------------ dot product */
/* The Q2_K, IQ1_S and IQ1_M sub-block dots, written for the single-token row
 * kernels. They take the row (the same for every lane of a wave), the byte
 * offset po of the 256-weight block inside it and the sub-block index b in
 * the row, and form every address as row + one 32-bit offset: on the GPU that
 * is a load with a wave-uniform base and a lane offset, with no 64-bit address
 * add per load. ie_rq_dot_sub calls them with po = 0 for the multi-token
 * kernels. The values are the ones the earlier per-block code produced, bit
 * for bit. */

/* the 4 int8 activations at word w of the sub-block x */
static inline ie_rq_u32 ie_rq_xw(IE_RQP *x, ie_rq_u32 w) { return ((IE_RQU *)x)[w]; }
/* exact sum of the 8 int8 activations of group g of the sub-block x */
static inline ie_rq_u32 ie_rq_xs8(IE_RQP *x, ie_rq_u32 g) {
  return ie_dot4_ss(ie_dot4_ss(0u, ie_rq_xw(x, 2u * g), 0x01010101u), ie_rq_xw(x, 2u * g + 1u), 0x01010101u);
}

static inline float ie_rq_sub_q2k(IE_RQP *row, ie_rq_u32 po, IE_RQP *xq, ie_rq_u32 nb, ie_rq_u32 b) {
#pragma clang fp contract(off)
  /* scales[16]: 4-bit scale (low) and 4-bit min (high) of 16 weights;
   * qs[64]: 32 bytes per 128 weights, 2 bits each, shift 0/2/4/6. */
  IE_RQF *da = (IE_RQF *)(xq + 32u * nb);
  const ie_rq_u32 s = b & 7u;
  IE_RQP *pd = row + po;
  IE_RQP *ps = row + (po + 2u * s);
  IE_RQP *pq = row + (po + (s >> 2u) * 32u);
  IE_RQP *x = xq + 32u * b;
  const float d = ie_rq_h2f(ie_rq_a16(pd, 80u)), mn = ie_rq_h2f(ie_rq_a16(pd, 82u));
  const ie_rq_u32 sc16 = ie_rq_a16(ps, 0u);
  /* The 2-bit values stay where they are (masked, not shifted down), so each
   * product is 2^sh times the real one; the exact integer sum of a half is
   * shifted down once. sh + 1 <= 7 keeps each value in its byte. */
  const ie_rq_u32 sh = 2u * (s & 3u), qmask = 0x03030303u << sh;
  const float dav = da[b];
  float acc = 0.0f;
  for (ie_rq_u32 h = 0; h < 2u; h++) {
    const ie_rq_u32 sc = (sc16 >> (8u * h)) & 255u;
    ie_rq_u32 idots = 0u;
    for (ie_rq_u32 w = 0; w < 4u; w++) idots = ie_dot4_us(idots, ie_rq_a32(pq, 16u + 16u * h + 4u * w) & qmask, ie_rq_xw(x, 4u * h + w));
    const ie_rq_u32 idot = (ie_rq_u32)((int)idots >> sh);
    const float dw = d * (float)(sc & 15u), dm = mn * (float)(sc >> 4u);
    acc += dav * (dw * (float)(int)idot - dm * (float)(int)(ie_rq_xs8(x, 2u * h) + ie_rq_xs8(x, 2u * h + 1u)));
  }
  return acc;
}

static inline float ie_rq_sub_iq2xxs(IE_RQP *row, ie_rq_u32 po, IE_RQP *xq, ie_rq_u32 nb, ie_rq_u32 b) {
#pragma clang fp contract(off)
  /* d, qs[32] u16: 4 grid indices and 3 sign indices + the 4-bit scale per 32 weights. */
  IE_RQF *da = (IE_RQF *)(xq + 32u * nb);
  const ie_rq_u32 s = b & 7u;
  IE_RQP *pd = row + po;
  IE_RQP *ps = row + (po + 8u * s);
  IE_RQP *x = xq + 32u * b;
  const float d = ie_rq_h2f(ie_rq_a16(pd, 0u));
  const ie_rq_u32 a0 = ie_rq_a32(ps, 2u), a1 = ie_rq_a32(ps, 6u);
  const float dw = d * (0.5f + (float)(a1 >> 28u)) * 0.25f;
  ie_rq_u32 idot = 0u;
  for (ie_rq_u32 l = 0; l < 4u; l++) {
    const ie_rq_u64 m = ie_rq_ksigns64[(a1 >> (7u * l)) & 127u], g = ie_rq_iq2xxs_grid[ie_byte(a0, l)];
    idot = ie_dot4_ss(ie_dot4_ss(idot, ie_rq_ssign((ie_rq_u32)g, (ie_rq_u32)m), ie_rq_xw(x, 2u * l)),
                      ie_rq_ssign((ie_rq_u32)(g >> 32u), (ie_rq_u32)(m >> 32u)), ie_rq_xw(x, 2u * l + 1u));
  }
  return da[b] * (dw * (float)(int)idot);
}

static inline float ie_rq_sub_iq2xs(IE_RQP *row, ie_rq_u32 po, IE_RQP *xq, ie_rq_u32 nb, ie_rq_u32 b) {
#pragma clang fp contract(off)
  /* d, qs[32] u16 (9-bit grid index, 7-bit signs), scales[8]: 4-bit scale of each 16 weights. */
  IE_RQF *da = (IE_RQF *)(xq + 32u * nb);
  const ie_rq_u32 s = b & 7u;
  IE_RQP *pd = row + po;
  IE_RQP *ps = row + (po + 8u * s);
  IE_RQP *psc = row + (po + 2u * (s >> 1u));
  IE_RQP *x = xq + 32u * b;
  const float d = ie_rq_h2f(ie_rq_a16(pd, 0u));
  const ie_rq_u32 sc = (ie_rq_a16(psc, 66u) >> (8u * (s & 1u))) & 255u;
  const float dw0 = d * (0.5f + (float)(sc & 15u)) * 0.25f, dw1 = d * (0.5f + (float)(sc >> 4u)) * 0.25f;
  ie_rq_u32 id0 = 0u, id1 = 0u;
  for (ie_rq_u32 l = 0; l < 4u; l++) {
    const ie_rq_u32 q2 = ie_rq_a16(ps, 2u + 2u * l);
    const ie_rq_u64 m = ie_rq_ksigns64[q2 >> 9u], g = ie_rq_iq2xs_grid[q2 & 511u];
    const ie_rq_u32 id = ie_dot4_ss(ie_dot4_ss(0u, ie_rq_ssign((ie_rq_u32)g, (ie_rq_u32)m), ie_rq_xw(x, 2u * l)),
                                    ie_rq_ssign((ie_rq_u32)(g >> 32u), (ie_rq_u32)(m >> 32u)), ie_rq_xw(x, 2u * l + 1u));
    if (l < 2u) id0 += id; else id1 += id;
  }
  return da[b] * (dw0 * (float)(int)id0 + dw1 * (float)(int)id1);
}

static inline float ie_rq_sub_iq2s(IE_RQP *row, ie_rq_u32 po, IE_RQP *xq, ie_rq_u32 nb, ie_rq_u32 b) {
#pragma clang fp contract(off)
  /* d, qs[64] (4 grid index bytes per 32 weights, then 4 sign bytes), qh[8], scales[8]. */
  IE_RQF *da = (IE_RQF *)(xq + 32u * nb);
  const ie_rq_u32 s = b & 7u;
  IE_RQP *pd = row + po;
  IE_RQP *ps4 = row + (po + 4u * s);
  IE_RQP *ps2 = row + (po + 2u * (s >> 1u));
  IE_RQP *x = xq + 32u * b;
  const float d = ie_rq_h2f(ie_rq_a16(pd, 0u));
  const ie_rq_u32 qh = (ie_rq_a16(ps2, 66u) >> (8u * (s & 1u))) & 255u;
  const ie_rq_u32 sc = (ie_rq_a16(ps2, 74u) >> (8u * (s & 1u))) & 255u;
  const ie_rq_u32 qlo = ie_rq_a32(ps4, 2u), sgn = ie_rq_a32(ps4, 34u);
  const float dw0 = d * (0.5f + (float)(sc & 15u)) * 0.25f, dw1 = d * (0.5f + (float)(sc >> 4u)) * 0.25f;
  ie_rq_u32 id0 = 0u, id1 = 0u;
  for (ie_rq_u32 l = 0; l < 4u; l++) {
    const ie_rq_u32 idx = ie_byte(qlo, l) | ((qh << (8u - 2u * l)) & 0x300u);
    const ie_rq_u64 m = ie_rq_mask8(ie_byte(sgn, l)), g = ie_rq_iq2s_grid[idx];
    const ie_rq_u32 id = ie_dot4_ss(ie_dot4_ss(0u, ie_rq_ssign((ie_rq_u32)g, (ie_rq_u32)m), ie_rq_xw(x, 2u * l)),
                                    ie_rq_ssign((ie_rq_u32)(g >> 32u), (ie_rq_u32)(m >> 32u)), ie_rq_xw(x, 2u * l + 1u));
    if (l < 2u) id0 += id; else id1 += id;
  }
  return da[b] * (dw0 * (float)(int)id0 + dw1 * (float)(int)id1);
}

static inline float ie_rq_sub_iq3xxs(IE_RQP *row, ie_rq_u32 po, IE_RQP *xq, ie_rq_u32 nb, ie_rq_u32 b) {
#pragma clang fp contract(off)
  /* d, qs[64] grid index bytes (2 per group of 8), then 8 u32 of 7-bit sign indices and 4-bit scale. */
  IE_RQF *da = (IE_RQF *)(xq + 32u * nb);
  const ie_rq_u32 s = b & 7u;
  IE_RQP *pd = row + po;
  IE_RQP *ps8 = row + (po + 8u * s);
  IE_RQP *ps4 = row + (po + 4u * s);
  IE_RQP *x = xq + 32u * b;
  const float d = ie_rq_h2f(ie_rq_a16(pd, 0u));
  const ie_rq_u32 aux = ie_rq_a32(ps4, 66u);
  const float dw = d * (0.5f + (float)(aux >> 28u)) * 0.5f;
  ie_rq_u32 idot = 0u;
  for (ie_rq_u32 l = 0; l < 4u; l++) {
    const ie_rq_u32 qp = ie_rq_a16(ps8, 2u + 2u * l);
    const ie_rq_u64 m = ie_rq_ksigns64[(aux >> (7u * l)) & 127u];
    const ie_rq_u32 g1 = ie_rq_iq3xxs_grid[qp & 255u], g2 = ie_rq_iq3xxs_grid[qp >> 8u];
    idot = ie_dot4_ss(ie_dot4_ss(idot, ie_rq_ssign(g1, (ie_rq_u32)m), ie_rq_xw(x, 2u * l)),
                      ie_rq_ssign(g2, (ie_rq_u32)(m >> 32u)), ie_rq_xw(x, 2u * l + 1u));
  }
  return da[b] * (dw * (float)(int)idot);
}

static inline float ie_rq_sub_iq3s(IE_RQP *row, ie_rq_u32 po, IE_RQP *xq, ie_rq_u32 nb, ie_rq_u32 b) {
#pragma clang fp contract(off)
  /* d, qs[64] (9th index bit in qh[8], two per group), signs[32], scales[4] (1 + 2*sc). */
  IE_RQF *da = (IE_RQF *)(xq + 32u * nb);
  const ie_rq_u32 s = b & 7u;
  IE_RQP *pd = row + po;
  IE_RQP *ps8 = row + (po + 8u * s);
  IE_RQP *ps4 = row + (po + 4u * s);
  IE_RQP *ps2 = row + (po + 2u * (s >> 1u));
  IE_RQP *psc = row + (po + 2u * (s >> 2u));
  IE_RQP *x = xq + 32u * b;
  const float d = ie_rq_h2f(ie_rq_a16(pd, 0u));
  const ie_rq_u32 qh = (ie_rq_a16(ps2, 66u) >> (8u * (s & 1u))) & 255u;
  const ie_rq_u32 sc = (ie_rq_a16(psc, 106u) >> (4u * (s & 3u))) & 15u;
  const ie_rq_u32 sgn = ie_rq_a32(ps4, 74u);
  const float dw = d * (float)(int)(1u + 2u * sc);
  ie_rq_u32 idot = 0u;
  for (ie_rq_u32 l = 0; l < 4u; l++) {
    const ie_rq_u32 qp = ie_rq_a16(ps8, 2u + 2u * l);
    const ie_rq_u64 m = ie_rq_mask8(ie_byte(sgn, l));
    const ie_rq_u32 i1 = (qp & 255u) | (((qh >> (2u * l)) & 1u) << 8u);
    const ie_rq_u32 i2 = (qp >> 8u) | (((qh >> (2u * l + 1u)) & 1u) << 8u);
    const ie_rq_u32 g1 = ie_rq_iq3s_grid[i1], g2 = ie_rq_iq3s_grid[i2];
    idot = ie_dot4_ss(ie_dot4_ss(idot, ie_rq_ssign(g1, (ie_rq_u32)m), ie_rq_xw(x, 2u * l)),
                      ie_rq_ssign(g2, (ie_rq_u32)(m >> 32u)), ie_rq_xw(x, 2u * l + 1u));
  }
  return da[b] * (dw * (float)(int)idot);
}

static inline float ie_rq_sub_iq1s(IE_RQP *row, ie_rq_u32 po, IE_RQP *xq, ie_rq_u32 nb, ie_rq_u32 b) {
#pragma clang fp contract(off)
  /* d, qs[32] grid index bytes, qh[8] u16: 3 grid bits per group, the
   * 3-bit scale (2 ls + 1) and the delta sign. weight = dl (grid +- .125),
   * so the delta term is +-0.125 * asum against the same scale: exact
   * (0.125 is a power of two) and added to the integer dot in float. */
  IE_RQF *da = (IE_RQF *)(xq + 32u * nb); /* the scale of each 32-block */
  IE_RQU *as = (IE_RQU *)(xq + 36u * nb); /* the int8 sum of each 32-block */
  const ie_rq_u32 s = b & 7u;
  IE_RQP *pd = row + po;
  IE_RQP *pi = row + (po + 4u * s);
  IE_RQP *ph = row + (po + 2u * s);
  IE_RQP *x = xq + 32u * b;
  const float d = ie_rq_h2f(ie_rq_a16(pd, 0u));
  const ie_rq_u32 qh = ie_rq_a16(ph, 34u), qlo = ie_rq_a32(pi, 2u);
  const float dw = d * (float)(int)(2u * ((qh >> 12u) & 7u) + 1u);
  const float del = (qh & 0x8000u) != 0u ? -0.125f : 0.125f; /* IQ1S_DELTA */
  ie_rq_u32 idot = 0u;
  for (ie_rq_u32 l = 0; l < 4u; l++) {
    const ie_rq_u32 idx = ie_byte(qlo, l) | (((qh >> (3u * l)) & 7u) << 8u);
    const ie_rq_u64 g = ie_rq_iq1s_grid[idx];
    idot = ie_dot4_ss(ie_dot4_ss(idot, (ie_rq_u32)g, ie_rq_xw(x, 2u * l)), (ie_rq_u32)(g >> 32u), ie_rq_xw(x, 2u * l + 1u));
  }
  return da[b] * (dw * ((float)(int)idot + del * (float)(int)as[b]));
}

static inline float ie_rq_sub_iq1m(IE_RQP *row, ie_rq_u32 po, IE_RQP *xq, ie_rq_u32 nb, ie_rq_u32 b) {
#pragma clang fp contract(off)
  /* qs[32], qh[16] (3 grid bits per group, one delta sign bit per
   * group), scales[8] u16: 3-bit scales per 16 weights, the f16 d in
   * their four spare high nibbles.
   * A weight is grid + delta with delta = +-1/8, so 8 * weight = 8 * grid +- 1 is an
   * integer. Per 8-weight group, T = (8 * grid +- 1) . x is an exact integer (on GPU folded
   * directly into the grid bytes via v_perm_b32), and (float)T / 8 is bitwise identical. */
  IE_RQF *da = (IE_RQF *)(xq + 32u * nb);
  const ie_rq_u32 s = b & 7u;
  IE_RQP *pd = row + po;
  IE_RQP *pi = row + (po + 4u * s);
  IE_RQP *ph = row + (po + 2u * s);
  IE_RQP *x = xq + 32u * b;
  const ie_rq_u32 slo = ie_rq_a32(pd, 48u), shi = ie_rq_a32(pd, 52u);
  const ie_rq_u32 s0 = slo & 0xFFFFu, s1 = slo >> 16u, s2 = shi & 0xFFFFu, s3 = shi >> 16u;
  const float d = ie_rq_h2f((s0 >> 12u) | ((s1 >> 8u) & 0x00F0u) | ((s2 >> 4u) & 0x0F00u) | (s3 & 0xF000u));
  const ie_rq_u32 pair = (s & 4u) != 0u ? shi : slo;                 /* sc[s >> 1] of ggml */
  const ie_rq_u32 scv = pair >> (16u * ((s >> 1u) & 1u)), qhb = ie_rq_a16(ph, 32u), qlo = ie_rq_a32(pi, 0u), sh = 6u * (s & 1u);
  const float dq0 = (d * (float)(int)(2u * ((scv >> sh) & 7u) + 1u)) * 0.125f;
  const float dq1 = (d * (float)(int)(2u * ((scv >> (sh + 3u)) & 7u) + 1u)) * 0.125f;
#ifdef __AMDGCN__
  ie_rq_u32 c0 = 0u, c1 = 0u;
  for (ie_rq_u32 l = 0; l < 4u; l++) {
    const ie_rq_u32 qh = l < 2u ? (qhb & 255u) : (qhb >> 8u);
    const ie_rq_u32 idx = ie_byte(qlo, l) | ((qh << (8u - 4u * (l & 1u))) & 0x700u);
    const ie_rq_u64 g = ie_rq_iq1s_grid[idx];
    const ie_rq_u32 tbl = (qh & ((l & 1u) != 0u ? 0x80u : 0x08u)) != 0u ? 0xF70007FFu : 0xF9000901u;
    const ie_rq_u32 wl = __builtin_amdgcn_perm(0u, tbl, (ie_rq_u32)g & 0x03030303u);
    const ie_rq_u32 wh = __builtin_amdgcn_perm(0u, tbl, (ie_rq_u32)(g >> 32u) & 0x03030303u);
    const ie_rq_u32 xl = ie_rq_xw(x, 2u * l), xh = ie_rq_xw(x, 2u * l + 1u);
    if (l < 2u) c0 = ie_dot4_ss(ie_dot4_ss(c0, wl, xl), wh, xh);
    else c1 = ie_dot4_ss(ie_dot4_ss(c1, wl, xl), wh, xh);
  }
  return da[b] * (dq0 * (float)(int)c0 + dq1 * (float)(int)c1);
#else
  int t0 = 0, t1 = 0;
  for (ie_rq_u32 l = 0; l < 4u; l++) {
    const ie_rq_u32 qh = l < 2u ? (qhb & 255u) : (qhb >> 8u);
    const ie_rq_u32 idx = ie_byte(qlo, l) | ((qh << (8u - 4u * (l & 1u))) & 0x700u);
    const ie_rq_u64 g = ie_rq_iq1s_grid[idx];
    const ie_rq_u32 sv = (qh & ((l & 1u) != 0u ? 0x80u : 0x08u)) != 0u ? 0xFFFFFFFFu : 0x01010101u;
    const ie_rq_u32 xl = ie_rq_xw(x, 2u * l), xh = ie_rq_xw(x, 2u * l + 1u);
    const ie_rq_u32 id = ie_dot4_ss(ie_dot4_ss(0u, (ie_rq_u32)g, xl), (ie_rq_u32)(g >> 32u), xh);
    const ie_rq_u32 dl = ie_dot4_ss(ie_dot4_ss(0u, sv, xl), sv, xh);
    const int tg = (int)((id << 3u) + dl);
    if (l < 2u) t0 += tg; else t1 += tg;
  }
  return da[b] * (dq0 * (float)t0 + dq1 * (float)t1);
#endif
}

/* The contribution of one raw 256-weight block p to the dot product of its
 * row against the Q8 activations xq: 8 sub-blocks (16- or 8-weight groups
 * where the format scales finer), ascending. */
static inline float ie_rq_dot_sub(ie_rq_u32 type, IE_RQP *p, IE_RQP *xq, ie_rq_u32 nb, ie_rq_u32 qb, ie_rq_u32 s_in) {
#pragma clang fp contract(off)
  const ie_rq_u32 b = 8u * qb + s_in;
  float acc = 0.0f;
  switch (type) {
    case IE_RQ_Q2_K: acc += ie_rq_sub_q2k(p, 0u, xq, nb, b); break;
    case IE_RQ_IQ2_XXS: acc += ie_rq_sub_iq2xxs(p, 0u, xq, nb, b); break;
    case IE_RQ_IQ2_XS: acc += ie_rq_sub_iq2xs(p, 0u, xq, nb, b); break;
    case IE_RQ_IQ2_S: acc += ie_rq_sub_iq2s(p, 0u, xq, nb, b); break;
    case IE_RQ_IQ3_XXS: acc += ie_rq_sub_iq3xxs(p, 0u, xq, nb, b); break;
    case IE_RQ_IQ3_S: acc += ie_rq_sub_iq3s(p, 0u, xq, nb, b); break;
    case IE_RQ_IQ1_S: acc += ie_rq_sub_iq1s(p, 0u, xq, nb, b); break;
    case IE_RQ_IQ1_M: acc += ie_rq_sub_iq1m(p, 0u, xq, nb, b); break;
    default: return 0.0f;
  }
  return acc;
}

/* sub-block b of a row of the raw weights (single-token row kernels): every
 * format forms addresses as wave-uniform row + 32-bit byte offset */
static inline float ie_rq_dot_row(ie_rq_u32 type, IE_RQP *row, IE_RQP *xq, ie_rq_u32 nb, ie_rq_u32 b) {
  switch (type) {
    case IE_RQ_Q2_K: return ie_rq_sub_q2k(row, (b >> 3u) * 84u, xq, nb, b);
    case IE_RQ_IQ2_XXS: return ie_rq_sub_iq2xxs(row, (b >> 3u) * 66u, xq, nb, b);
    case IE_RQ_IQ2_XS: return ie_rq_sub_iq2xs(row, (b >> 3u) * 74u, xq, nb, b);
    case IE_RQ_IQ2_S: return ie_rq_sub_iq2s(row, (b >> 3u) * 82u, xq, nb, b);
    case IE_RQ_IQ3_XXS: return ie_rq_sub_iq3xxs(row, (b >> 3u) * 98u, xq, nb, b);
    case IE_RQ_IQ3_S: return ie_rq_sub_iq3s(row, (b >> 3u) * 110u, xq, nb, b);
    case IE_RQ_IQ1_S: return ie_rq_sub_iq1s(row, (b >> 3u) * 50u, xq, nb, b);
    case IE_RQ_IQ1_M: return ie_rq_sub_iq1m(row, (b >> 3u) * 56u, xq, nb, b);
    default: return 0.0f;
  }
}

#if defined(__AMDGCN__) && !defined(IE_MEGA)
static inline float ie_rq_sub_iq2xxs_lds(IE_RQP *row, ie_rq_u32 po, IE_RQP *xq, ie_rq_u32 nb, ie_rq_u32 b,
                                         const __attribute__((address_space(3))) ie_rq_u64 *g64) {
#pragma clang fp contract(off)
  IE_RQF *da = (IE_RQF *)(xq + 32u * nb);
  const ie_rq_u32 s = b & 7u;
  IE_RQP *pd = row + po;
  IE_RQP *ps = row + (po + 8u * s);
  IE_RQP *x = xq + 32u * b;
  const float d = ie_rq_h2f(ie_rq_a16(pd, 0u));
  const ie_rq_u32 a0 = ie_rq_a32(ps, 2u), a1 = ie_rq_a32(ps, 6u);
  const float dw = d * (0.5f + (float)(a1 >> 28u)) * 0.25f;
  const __attribute__((address_space(3))) ie_rq_u64 *sgn = g64 + 256u;
  ie_rq_u32 idot = 0u;
  for (ie_rq_u32 l = 0; l < 4u; l++) {
    const ie_rq_u64 m = sgn[(a1 >> (7u * l)) & 127u], g = g64[ie_byte(a0, l)];
    idot = ie_dot4_ss(ie_dot4_ss(idot, ie_rq_ssign((ie_rq_u32)g, (ie_rq_u32)m), ie_rq_xw(x, 2u * l)),
                      ie_rq_ssign((ie_rq_u32)(g >> 32u), (ie_rq_u32)(m >> 32u)), ie_rq_xw(x, 2u * l + 1u));
  }
  return da[b] * (dw * (float)(int)idot);
}

static inline float ie_rq_sub_iq2xs_lds(IE_RQP *row, ie_rq_u32 po, IE_RQP *xq, ie_rq_u32 nb, ie_rq_u32 b,
                                        const __attribute__((address_space(3))) ie_rq_u64 *g64) {
#pragma clang fp contract(off)
  IE_RQF *da = (IE_RQF *)(xq + 32u * nb);
  const ie_rq_u32 s = b & 7u;
  IE_RQP *pd = row + po;
  IE_RQP *ps = row + (po + 8u * s);
  IE_RQP *psc = row + (po + 2u * (s >> 1u));
  IE_RQP *x = xq + 32u * b;
  const float d = ie_rq_h2f(ie_rq_a16(pd, 0u));
  const ie_rq_u32 sc = (ie_rq_a16(psc, 66u) >> (8u * (s & 1u))) & 255u;
  const float dw0 = d * (0.5f + (float)(sc & 15u)) * 0.25f, dw1 = d * (0.5f + (float)(sc >> 4u)) * 0.25f;
  const __attribute__((address_space(3))) ie_rq_u64 *sgn = g64 + 512u;
  ie_rq_u32 id0 = 0u, id1 = 0u;
  for (ie_rq_u32 l = 0; l < 4u; l++) {
    const ie_rq_u32 q2 = ie_rq_a16(ps, 2u + 2u * l);
    const ie_rq_u64 m = sgn[q2 >> 9u], g = g64[q2 & 511u];
    const ie_rq_u32 id = ie_dot4_ss(ie_dot4_ss(0u, ie_rq_ssign((ie_rq_u32)g, (ie_rq_u32)m), ie_rq_xw(x, 2u * l)),
                                    ie_rq_ssign((ie_rq_u32)(g >> 32u), (ie_rq_u32)(m >> 32u)), ie_rq_xw(x, 2u * l + 1u));
    if (l < 2u) id0 += id; else id1 += id;
  }
  return da[b] * (dw0 * (float)(int)id0 + dw1 * (float)(int)id1);
}

static inline float ie_rq_sub_iq2s_lds(IE_RQP *row, ie_rq_u32 po, IE_RQP *xq, ie_rq_u32 nb, ie_rq_u32 b,
                                       const __attribute__((address_space(3))) ie_rq_u64 *g64) {
#pragma clang fp contract(off)
  IE_RQF *da = (IE_RQF *)(xq + 32u * nb);
  const ie_rq_u32 s = b & 7u;
  IE_RQP *pd = row + po;
  IE_RQP *ps4 = row + (po + 4u * s);
  IE_RQP *ps2 = row + (po + 2u * (s >> 1u));
  IE_RQP *x = xq + 32u * b;
  const float d = ie_rq_h2f(ie_rq_a16(pd, 0u));
  const ie_rq_u32 qh = (ie_rq_a16(ps2, 66u) >> (8u * (s & 1u))) & 255u;
  const ie_rq_u32 sc = (ie_rq_a16(ps2, 74u) >> (8u * (s & 1u))) & 255u;
  const ie_rq_u32 qlo = ie_rq_a32(ps4, 2u), sgn = ie_rq_a32(ps4, 34u);
  const float dw0 = d * (0.5f + (float)(sc & 15u)) * 0.25f, dw1 = d * (0.5f + (float)(sc >> 4u)) * 0.25f;
  ie_rq_u32 id0 = 0u, id1 = 0u;
  for (ie_rq_u32 l = 0; l < 4u; l++) {
    const ie_rq_u32 idx = ie_byte(qlo, l) | ((qh << (8u - 2u * l)) & 0x300u);
    const ie_rq_u64 m = ie_rq_mask8(ie_byte(sgn, l)), g = g64[idx];
    const ie_rq_u32 id = ie_dot4_ss(ie_dot4_ss(0u, ie_rq_ssign((ie_rq_u32)g, (ie_rq_u32)m), ie_rq_xw(x, 2u * l)),
                                    ie_rq_ssign((ie_rq_u32)(g >> 32u), (ie_rq_u32)(m >> 32u)), ie_rq_xw(x, 2u * l + 1u));
    if (l < 2u) id0 += id; else id1 += id;
  }
  return da[b] * (dw0 * (float)(int)id0 + dw1 * (float)(int)id1);
}

static inline float ie_rq_sub_iq3xxs_lds(IE_RQP *row, ie_rq_u32 po, IE_RQP *xq, ie_rq_u32 nb, ie_rq_u32 b,
                                         const __attribute__((address_space(3))) ie_rq_u64 *g64) {
#pragma clang fp contract(off)
  IE_RQF *da = (IE_RQF *)(xq + 32u * nb);
  const ie_rq_u32 s = b & 7u;
  IE_RQP *pd = row + po;
  IE_RQP *ps8 = row + (po + 8u * s);
  IE_RQP *ps4 = row + (po + 4u * s);
  IE_RQP *x = xq + 32u * b;
  const float d = ie_rq_h2f(ie_rq_a16(pd, 0u));
  const ie_rq_u32 aux = ie_rq_a32(ps4, 66u);
  const float dw = d * (0.5f + (float)(aux >> 28u)) * 0.5f;
  const __attribute__((address_space(3))) ie_rq_u32 *g32 = (const __attribute__((address_space(3))) ie_rq_u32 *)g64;
  const __attribute__((address_space(3))) ie_rq_u64 *sgn = g64 + 128u;
  ie_rq_u32 idot = 0u;
  for (ie_rq_u32 l = 0; l < 4u; l++) {
    const ie_rq_u32 qp = ie_rq_a16(ps8, 2u + 2u * l);
    const ie_rq_u64 m = sgn[(aux >> (7u * l)) & 127u];
    const ie_rq_u32 g1 = g32[qp & 255u], g2 = g32[qp >> 8u];
    idot = ie_dot4_ss(ie_dot4_ss(idot, ie_rq_ssign(g1, (ie_rq_u32)m), ie_rq_xw(x, 2u * l)),
                      ie_rq_ssign(g2, (ie_rq_u32)(m >> 32u)), ie_rq_xw(x, 2u * l + 1u));
  }
  return da[b] * (dw * (float)(int)idot);
}

static inline float ie_rq_sub_iq3s_lds(IE_RQP *row, ie_rq_u32 po, IE_RQP *xq, ie_rq_u32 nb, ie_rq_u32 b,
                                       const __attribute__((address_space(3))) ie_rq_u64 *g64) {
#pragma clang fp contract(off)
  IE_RQF *da = (IE_RQF *)(xq + 32u * nb);
  const ie_rq_u32 s = b & 7u;
  IE_RQP *pd = row + po;
  IE_RQP *ps8 = row + (po + 8u * s);
  IE_RQP *ps4 = row + (po + 4u * s);
  IE_RQP *ps2 = row + (po + 2u * (s >> 1u));
  IE_RQP *psc = row + (po + 2u * (s >> 2u));
  IE_RQP *x = xq + 32u * b;
  const float d = ie_rq_h2f(ie_rq_a16(pd, 0u));
  const ie_rq_u32 qh = (ie_rq_a16(ps2, 66u) >> (8u * (s & 1u))) & 255u;
  const ie_rq_u32 sc = (ie_rq_a16(psc, 106u) >> (4u * (s & 3u))) & 15u;
  const ie_rq_u32 sgn = ie_rq_a32(ps4, 74u);
  const float dw = d * (float)(int)(1u + 2u * sc);
  const __attribute__((address_space(3))) ie_rq_u32 *g32 = (const __attribute__((address_space(3))) ie_rq_u32 *)g64;
  ie_rq_u32 idot = 0u;
  for (ie_rq_u32 l = 0; l < 4u; l++) {
    const ie_rq_u32 qp = ie_rq_a16(ps8, 2u + 2u * l);
    const ie_rq_u64 m = ie_rq_mask8(ie_byte(sgn, l));
    const ie_rq_u32 i1 = (qp & 255u) | (((qh >> (2u * l)) & 1u) << 8u);
    const ie_rq_u32 i2 = (qp >> 8u) | (((qh >> (2u * l + 1u)) & 1u) << 8u);
    const ie_rq_u32 g1 = g32[i1], g2 = g32[i2];
    idot = ie_dot4_ss(ie_dot4_ss(idot, ie_rq_ssign(g1, (ie_rq_u32)m), ie_rq_xw(x, 2u * l)),
                      ie_rq_ssign(g2, (ie_rq_u32)(m >> 32u)), ie_rq_xw(x, 2u * l + 1u));
  }
  return da[b] * (dw * (float)(int)idot);
}

static inline float ie_rq_sub_iq1s_lds(IE_RQP *row, ie_rq_u32 po, IE_RQP *xq, ie_rq_u32 nb, ie_rq_u32 b,
                                       const __attribute__((address_space(3))) ie_rq_u64 *g1s) {
#pragma clang fp contract(off)
  IE_RQF *da = (IE_RQF *)(xq + 32u * nb);
  IE_RQU *as = (IE_RQU *)(xq + 36u * nb);
  const ie_rq_u32 s = b & 7u;
  IE_RQP *pd = row + po;
  IE_RQP *pi = row + (po + 4u * s);
  IE_RQP *ph = row + (po + 2u * s);
  IE_RQP *x = xq + 32u * b;
  const float d = ie_rq_h2f(ie_rq_a16(pd, 0u));
  const ie_rq_u32 qh = ie_rq_a16(ph, 34u), qlo = ie_rq_a32(pi, 2u);
  const float dw = d * (float)(int)(2u * ((qh >> 12u) & 7u) + 1u);
  const float del = (qh & 0x8000u) != 0u ? -0.125f : 0.125f;
  ie_rq_u32 idot = 0u;
  for (ie_rq_u32 l = 0; l < 4u; l++) {
    const ie_rq_u32 idx = ie_byte(qlo, l) | (((qh >> (3u * l)) & 7u) << 8u);
    const ie_rq_u64 g = g1s[idx];
    idot = ie_dot4_ss(ie_dot4_ss(idot, (ie_rq_u32)g, ie_rq_xw(x, 2u * l)), (ie_rq_u32)(g >> 32u), ie_rq_xw(x, 2u * l + 1u));
  }
  return da[b] * (dw * ((float)(int)idot + del * (float)(int)as[b]));
}

static inline float ie_rq_sub_iq1m_lds(IE_RQP *row, ie_rq_u32 po, IE_RQP *xq, ie_rq_u32 nb, ie_rq_u32 b,
                                       const __attribute__((address_space(3))) ie_rq_u64 *g1s) {
#pragma clang fp contract(off)
  IE_RQF *da = (IE_RQF *)(xq + 32u * nb);
  const ie_rq_u32 s = b & 7u;
  IE_RQP *pd = row + po;
  IE_RQP *pi = row + (po + 4u * s);
  IE_RQP *ph = row + (po + 2u * s);
  IE_RQP *x = xq + 32u * b;
  const ie_rq_u32 slo = ie_rq_a32(pd, 48u), shi = ie_rq_a32(pd, 52u);
  const ie_rq_u32 s0 = slo & 0xFFFFu, s1 = slo >> 16u, s2 = shi & 0xFFFFu, s3 = shi >> 16u;
  const float d = ie_rq_h2f((s0 >> 12u) | ((s1 >> 8u) & 0x00F0u) | ((s2 >> 4u) & 0x0F00u) | (s3 & 0xF000u));
  const ie_rq_u32 pair = (s & 4u) != 0u ? shi : slo;
  const ie_rq_u32 scv = pair >> (16u * ((s >> 1u) & 1u)), qhb = ie_rq_a16(ph, 32u), qlo = ie_rq_a32(pi, 0u), sh = 6u * (s & 1u);
  const float dq0 = (d * (float)(int)(2u * ((scv >> sh) & 7u) + 1u)) * 0.125f;
  const float dq1 = (d * (float)(int)(2u * ((scv >> (sh + 3u)) & 7u) + 1u)) * 0.125f;
  ie_rq_u32 c0 = 0u, c1 = 0u;
  for (ie_rq_u32 l = 0; l < 4u; l++) {
    const ie_rq_u32 qh = l < 2u ? (qhb & 255u) : (qhb >> 8u);
    const ie_rq_u32 idx = ie_byte(qlo, l) | ((qh << (8u - 4u * (l & 1u))) & 0x700u);
    const ie_rq_u64 g = g1s[idx];
    const ie_rq_u32 tbl = (qh & ((l & 1u) != 0u ? 0x80u : 0x08u)) != 0u ? 0xF70007FFu : 0xF9000901u;
    const ie_rq_u32 wl = __builtin_amdgcn_perm(0u, tbl, (ie_rq_u32)g & 0x03030303u);
    const ie_rq_u32 wh = __builtin_amdgcn_perm(0u, tbl, (ie_rq_u32)(g >> 32u) & 0x03030303u);
    const ie_rq_u32 xl = ie_rq_xw(x, 2u * l), xh = ie_rq_xw(x, 2u * l + 1u);
    if (l < 2u) c0 = ie_dot4_ss(ie_dot4_ss(c0, wl, xl), wh, xh);
    else c1 = ie_dot4_ss(ie_dot4_ss(c1, wl, xl), wh, xh);
  }
  return da[b] * (dq0 * (float)(int)c0 + dq1 * (float)(int)c1);
}

static inline float ie_rq_dot_row_lds(ie_rq_u32 type, IE_RQP *row, IE_RQP *xq, ie_rq_u32 nb, ie_rq_u32 b,
                                      const __attribute__((address_space(3))) ie_rq_u64 *g1s) {
  switch (type) {
    case IE_RQ_IQ2_XXS: return ie_rq_sub_iq2xxs_lds(row, (b >> 3u) * 66u, xq, nb, b, g1s);
    case IE_RQ_IQ2_XS: return ie_rq_sub_iq2xs_lds(row, (b >> 3u) * 74u, xq, nb, b, g1s);
    case IE_RQ_IQ2_S: return ie_rq_sub_iq2s_lds(row, (b >> 3u) * 82u, xq, nb, b, g1s);
    case IE_RQ_IQ3_XXS: return ie_rq_sub_iq3xxs_lds(row, (b >> 3u) * 98u, xq, nb, b, g1s);
    case IE_RQ_IQ3_S: return ie_rq_sub_iq3s_lds(row, (b >> 3u) * 110u, xq, nb, b, g1s);
    case IE_RQ_IQ1_S: return ie_rq_sub_iq1s_lds(row, (b >> 3u) * 50u, xq, nb, b, g1s);
    case IE_RQ_IQ1_M: return ie_rq_sub_iq1m_lds(row, (b >> 3u) * 56u, xq, nb, b, g1s);
    default: return ie_rq_dot_row(type, row, xq, nb, b);
  }
}
#endif

/* The whole 256-weight block: its eight sub-blocks in ascending order, which
 * is the order every caller used before the sub-block mapping and keeps the
 * CPU backend bit-compatible with the TR kernels. */
static inline float ie_rq_dot(ie_rq_u32 type, IE_RQP *p, IE_RQP *xq, ie_rq_u32 nb, ie_rq_u32 qb) {
  float acc = 0.0f;
  /* rolled on purpose: the TR kernels call this once per token, and an unrolled
   * 8-case expander per token (8 tokens) costs 64 inlined bodies - the q2k and
   * iq1m TR kernels then pass 256 VGPR and spill (private segment, NaN). */
#pragma clang loop unroll(disable)
  for (ie_rq_u32 s = 0; s < 8u; s++) acc += ie_rq_dot_sub(type, p, xq, nb, qb, s);
  return acc;
}

/* ---------------------------------------------------------- dequantizers */
#ifdef IE_RAWQ_HOST
/* byte loads of the raw block (plain host pointer) */
static inline ie_rq_u32 ie_rq_hb(const ie_rq_u8 *p, ie_rq_u32 i) { return p[i]; }
static inline ie_rq_u32 ie_rq_hb16(const ie_rq_u8 *p, ie_rq_u32 i) { return (ie_rq_u32)p[i] | ((ie_rq_u32)p[i + 1u] << 8u); }
static inline ie_rq_u32 ie_rq_hb32(const ie_rq_u8 *p, ie_rq_u32 i) { return ie_rq_hb16(p, i) | (ie_rq_hb16(p, i + 2u) << 16u); }

/* The 256 float weights of one raw block, the values ggml's
 * dequantize_row_* produce, in element order 0..255. */
static void ie_rq_dequant(ie_rq_u32 type, const ie_rq_u8 *p, float *y) {
#pragma clang fp contract(off)
  switch (type) {
    case IE_RQ_Q2_K: {
      const float d = ie_rq_h2f(ie_rq_hb16(p, 80u)), mn = ie_rq_h2f(ie_rq_hb16(p, 82u));
      ie_rq_u32 is = 0u, o = 0u;
      for (ie_rq_u32 n = 0; n < 2u; n++) {
        for (ie_rq_u32 sh = 0u; sh < 8u; sh += 2u) {
          for (ie_rq_u32 h = 0; h < 2u; h++) {
            const ie_rq_u32 sc = ie_rq_hb(p, is++);
            const float dl = d * (float)(sc & 15u), ml = mn * (float)(sc >> 4u);
            const ie_rq_u32 qb = 16u + 32u * n + 16u * h;
            for (ie_rq_u32 l = 0; l < 16u; l++) y[o++] = dl * (float)((ie_rq_hb(p, qb + l) >> sh) & 3u) - ml;
          }
        }
      }
      break;
    }
    case IE_RQ_IQ2_XXS: {
      const float d = ie_rq_h2f(ie_rq_hb16(p, 0u));
      for (ie_rq_u32 s = 0; s < 8u; s++) {
        const ie_rq_u32 o = 2u + 8u * s;
        const ie_rq_u32 a0 = ie_rq_hb16(p, o) | (ie_rq_hb16(p, o + 2u) << 16u);
        const ie_rq_u32 a1 = ie_rq_hb16(p, o + 4u) | (ie_rq_hb16(p, o + 6u) << 16u);
        const float db = d * (0.5f + (float)(a1 >> 28u)) * 0.25f;
        for (ie_rq_u32 l = 0; l < 4u; l++) {
          const ie_rq_u64 g = ie_rq_iq2xxs_grid[ie_byte(a0, l)], m = ie_rq_ksigns64[(a1 >> (7u * l)) & 127u];
          for (ie_rq_u32 j = 0; j < 8u; j++) y[8u * (4u * s + l) + j] = ie_rq_gval(g, m, j, db);
        }
      }
      break;
    }
    case IE_RQ_IQ2_XS: {
      const float d = ie_rq_h2f(ie_rq_hb16(p, 0u));
      for (ie_rq_u32 s = 0; s < 8u; s++) {
        const ie_rq_u32 sc = ie_rq_hb(p, 66u + s);
        const float db0 = d * (0.5f + (float)(sc & 15u)) * 0.25f, db1 = d * (0.5f + (float)(sc >> 4u)) * 0.25f;
        for (ie_rq_u32 l = 0; l < 4u; l++) {
          const ie_rq_u32 q2 = ie_rq_hb16(p, 2u + 8u * s + 2u * l);
          const ie_rq_u64 g = ie_rq_iq2xs_grid[q2 & 511u], m = ie_rq_ksigns64[q2 >> 9u];
          const float dl = l < 2u ? db0 : db1;
          for (ie_rq_u32 j = 0; j < 8u; j++) y[8u * (4u * s + l) + j] = ie_rq_gval(g, m, j, dl);
        }
      }
      break;
    }
    case IE_RQ_IQ2_S: {
      const float d = ie_rq_h2f(ie_rq_hb16(p, 0u));
      for (ie_rq_u32 s = 0; s < 8u; s++) {
        const ie_rq_u32 qh = ie_rq_hb(p, 66u + s), sc = ie_rq_hb(p, 74u + s);
        const float db0 = d * (0.5f + (float)(sc & 15u)) * 0.25f, db1 = d * (0.5f + (float)(sc >> 4u)) * 0.25f;
        for (ie_rq_u32 l = 0; l < 4u; l++) {
          const ie_rq_u32 idx = ie_rq_hb(p, 2u + 4u * s + l) | ((qh << (8u - 2u * l)) & 0x300u);
          const ie_rq_u64 g = ie_rq_iq2s_grid[idx], m = ie_rq_mask8(ie_rq_hb(p, 34u + 4u * s + l));
          const float dl = l < 2u ? db0 : db1;
          for (ie_rq_u32 j = 0; j < 8u; j++) y[8u * (4u * s + l) + j] = ie_rq_gval(g, m, j, dl);
        }
      }
      break;
    }
    case IE_RQ_IQ3_XXS: {
      const float d = ie_rq_h2f(ie_rq_hb16(p, 0u));
      for (ie_rq_u32 s = 0; s < 8u; s++) {
        const ie_rq_u32 aux = ie_rq_hb32(p, 66u + 4u * s);
        const float db = d * (0.5f + (float)(aux >> 28u)) * 0.5f;
        for (ie_rq_u32 l = 0; l < 4u; l++) {
          const ie_rq_u64 m = ie_rq_ksigns64[(aux >> (7u * l)) & 127u];
          const ie_rq_u32 g1 = ie_rq_iq3xxs_grid[ie_rq_hb(p, 2u + 8u * s + 2u * l)];
          const ie_rq_u32 g2 = ie_rq_iq3xxs_grid[ie_rq_hb(p, 2u + 8u * s + 2u * l + 1u)];
          for (ie_rq_u32 j = 0; j < 4u; j++) {
            y[8u * (4u * s + l) + j] = ie_rq_gval((ie_rq_u64)g1, m, j, db);
            y[8u * (4u * s + l) + 4u + j] = ie_rq_gval((ie_rq_u64)g2, m >> 32u, j, db);
          }
        }
      }
      break;
    }
    case IE_RQ_IQ1_S: {
      const float d = ie_rq_h2f(ie_rq_hb16(p, 0u));
      for (ie_rq_u32 s = 0; s < 8u; s++) {
        const ie_rq_u32 qh = ie_rq_hb16(p, 34u + 2u * s);
        const float dl = d * (float)(int)(2u * ((qh >> 12u) & 7u) + 1u);
        const float delta = (qh & 0x8000u) != 0u ? -0.125f : 0.125f;
        for (ie_rq_u32 l = 0; l < 4u; l++) {
          const ie_rq_u32 idx = ie_rq_hb(p, 2u + 4u * s + l) | (((qh >> (3u * l)) & 7u) << 8u);
          const ie_rq_u64 g = ie_rq_iq1s_grid[idx];
          for (ie_rq_u32 j = 0; j < 8u; j++) y[8u * (4u * s + l) + j] = dl * ((float)(ie_rq_i8)ie_rq_gb(g, j) + delta);
        }
      }
      break;
    }
    case IE_RQ_IQ1_M: {
      const ie_rq_u32 s0 = ie_rq_hb16(p, 48u), s1 = ie_rq_hb16(p, 50u), s2 = ie_rq_hb16(p, 52u), s3 = ie_rq_hb16(p, 54u);
      const float d = ie_rq_h2f((s0 >> 12u) | ((s1 >> 8u) & 0x00F0u) | ((s2 >> 4u) & 0x0F00u) | (s3 & 0xF000u));
      for (ie_rq_u32 s = 0; s < 8u; s++) {
        const ie_rq_u32 scv = s < 2u ? s0 : s < 4u ? s1 : s < 6u ? s2 : s3;
        const ie_rq_u32 qh0 = ie_rq_hb(p, 32u + 2u * s), qh1 = ie_rq_hb(p, 33u + 2u * s);
        const float dl1 = d * (float)(int)(2u * ((scv >> (6u * (s & 1u))) & 7u) + 1u);
        const float dl2 = d * (float)(int)(2u * ((scv >> (6u * (s & 1u) + 3u)) & 7u) + 1u);
        for (ie_rq_u32 l = 0; l < 4u; l++) {
          const ie_rq_u32 qh = l < 2u ? qh0 : qh1;
          const ie_rq_u32 idx = ie_rq_hb(p, 4u * s + l) | ((qh << (8u - 4u * (l & 1u))) & 0x700u);
          const ie_rq_u64 g = ie_rq_iq1s_grid[idx];
          const float dl = l < 2u ? dl1 : dl2;
          const float delta = (qh & ((l & 1u) != 0u ? 0x80u : 0x08u)) != 0u ? -0.125f : 0.125f;
          for (ie_rq_u32 j = 0; j < 8u; j++) y[8u * (4u * s + l) + j] = dl * ((float)(ie_rq_i8)ie_rq_gb(g, j) + delta);
        }
      }
      break;
    }
    case IE_RQ_IQ3_S: {
      const float d = ie_rq_h2f(ie_rq_hb16(p, 0u));
      for (ie_rq_u32 s = 0; s < 8u; s++) {
        const ie_rq_u32 qh = ie_rq_hb(p, 66u + s), sc = ie_rq_hb(p, 106u + (s >> 1u));
        const float dw = d * (float)(int)(1u + 2u * ((sc >> (4u * (s & 1u))) & 15u));
        for (ie_rq_u32 l = 0; l < 4u; l++) {
          const ie_rq_u32 sm = ie_rq_hb(p, 74u + 4u * s + l);
          const ie_rq_u32 i1 = ie_rq_hb(p, 2u + 8u * s + 2u * l) | (((qh >> (2u * l)) & 1u) << 8u);
          const ie_rq_u32 i2 = ie_rq_hb(p, 2u + 8u * s + 2u * l + 1u) | (((qh >> (2u * l + 1u)) & 1u) << 8u);
          const ie_rq_u32 g1 = ie_rq_iq3s_grid[i1], g2 = ie_rq_iq3s_grid[i2];
          for (ie_rq_u32 j = 0; j < 4u; j++) {
            y[32u * s + 8u * l + j] = dw * (float)ie_byte(g1, j) * (((sm >> j) & 1u) != 0u ? -1.0f : 1.0f);
            y[32u * s + 8u * l + 4u + j] = dw * (float)ie_byte(g2, j) * (((sm >> (j + 4u)) & 1u) != 0u ? -1.0f : 1.0f);
          }
        }
      }
      break;
    }
    default: break;
  }
}

/* A whole row of cols weights (cols % 256 == 0: every block is complete). */
static inline void ie_rq_dequant_row(ie_rq_u32 type, const ie_rq_u8 *src, ie_rq_u32 cols, float *out) {
  const ie_rq_u32 bs = ie_rq_bs(type), nb = cols / 256u;
  for (ie_rq_u32 b = 0; b < nb; b++) ie_rq_dequant(type, src + b * bs, out + 256u * b);
}
